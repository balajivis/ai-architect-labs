__pycache__/
*.pyc
*.db
# shipped pre-embedded corpus (fast first load) — keep it tracked despite *.db
!mai_rag/data/policy.db
.smoke/
.venv/
.build-venv/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# Local secrets — the glob matters: `.env` alone would leave `.env.tmp`,
# `.env.local`, `.env.bak` tracked and one `git add -A` from being published.
.env
.env.*
!.env.example

# Lab 8 audit trail — each student's audit log is theirs; it also carries
# subject identifiers (token `sub`) and must never be committed.
labs/mcp_server/audit/

# Lab 4b memory stack — each student's agent memory is theirs, never committed
.memory/
labs/__pycache__/
node_modules/
/labs/mcp_server/package-lock.json

# ask.py persisted thread memory (per-student, local)
.ask_history.json

# dedicated eval venv (ragas needs an old langchain — kept out of the labs venv)
.venv-evals/

# Lab-generated plots (each run overwrites them; they're student output, not source)
/lab1b_size_sweep.png
/lab2_umap.png
/lab2c_graph.png
/lab6_gauntlet.png
/lab6_safety_gate.png

# deepeval's local telemetry cache
.deepeval/

# Lab 0 console output — the student's own architecture decision record
/my_architecture.json
/my_architecture.md
