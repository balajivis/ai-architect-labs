# Copy to .env and paste your CLASS TOKEN below — that's the only thing to fill in.
# The base URL is already set, so mai_rag routes to the class LLM proxy (small model) automatically.
OPENAI_API_KEY=paste-your-class-token-here
OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1
# NOTE: leave GROQ_API_KEY UNSET while using the class proxy — mai_rag prefers Groq if it's set.

# ── OR bring your own key (use ANY ONE; then delete the OPENAI_BASE_URL line above) ──
# GROQ_API_KEY=gsk_your_key_here        # free tier: https://console.groq.com/keys
# OPENAI_API_KEY=sk-...                 # your own OpenAI key (leave OPENAI_BASE_URL unset)
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# ── Lab 8 (MCP) — NON-SECRET knobs, env-only. No real secret goes here. ──────
# The Python→Node seam ports + a synthetic dev bearer for the OAuth harden moves.
# MCP_DEV_TOKEN is a SYNTHETIC HS256 dev token minted by the lab (pyjwt), not a
# real credential; auth.ts/server.ts read process.env only and never inline it.
MCP_BRIDGE_PORT=8765
MCP_SERVER_PORT=9000
MCP_DEV_TOKEN=
# Expected RFC 8707 audience the server binds tokens to (Move 5). Placeholder URL,
# not a secret — the fixture token's `aud` must match this to pass validation.
MCP_EXPECTED_AUD=http://127.0.0.1:9000/mcp
